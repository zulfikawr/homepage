{
  "name": "zulfikar",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint . --fix --type-aware --type-check && bunx prettier --write .",
    "lint:changed": "git diff --name-only --diff-filter=ACM HEAD | grep -E '\\.(js|jsx|ts|tsx)$' | xargs -r oxlint --fix --type-aware --type-check && git diff --name-only --diff-filter=ACM HEAD | grep -E '\\.(js|jsx|ts|tsx|json|css|md)$' | xargs -r prettier --write",
    "analyze": "bash scripts/analyze-performance.sh",
    "clean": "rm -rf .next .open-next node_modules && bun install"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "geojson": "^0.5.0",
    "marked": "^18.0.11",
    "next": "^16.3.4",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "next-themes": "^0.4.6",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
