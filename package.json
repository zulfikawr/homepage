  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint . --fix --type-aware --type-check && bunx prettier --write .",
    "test": "bun test",
    "test:crud": "bun test tests/database-crud.test.ts",
    "perf": "bash scripts/perf.sh",
    "lint:changed": "git diff --name-only --diff-filter=ACM HEAD | grep -E '\\.(js|jsx|ts|tsx)$' | xargs -r oxlint --fix --type-aware --type-check && git diff --name-only --diff-filter=ACM HEAD | grep -E '\\.(js|jsx|ts|tsx|json|css|md)$' | xargs -r prettier --write",
    "clean": "rm -rf .next .open-next node_modules && bun install"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "geojson": "^0.5.0",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "prettier": "^3.10.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shimmer-from-structure": "2.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
