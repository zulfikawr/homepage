    "autoprefixer": "^10.6.2",
    "next-themes": "^0.4.6",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
